# Secrets — .env.example is the only one that is ever committed.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
*.egg-info/
dist/
build/

# Node
node_modules/
web/dist/
*.tsbuildinfo
npm-debug.log*

# Local data — uploaded CVs and rendered documents are PII (Constitution §8). They belong in a
# volume, never in the repository, and never in a diff.
uploads/
backups/
*.dump

# Celery Beat's last-run database. It belongs on a volume (see docker-compose.yml); this is the
# backstop for the day someone runs `celery beat` by hand in the source tree.
celerybeat-schedule*
celerybeat.pid

# Docs — kept local, out of version control by the owner's decision (2026-09-04).
# Note the consequence: docs/constitution.md, docs/adr/ and docs/PRD.md are the durable
# documents everything else links to, and a fresh clone will not have them.
docs/

# Editors / OS
.idea/
.vscode/
.DS_Store

# Claude Code local overrides (settings.json IS committed — the hooks are part of the harness)
.claude/settings.local.json
