__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
*.egg-info/
dist/
build/

# Node
node_modules/
web/dist/
*.tsbuildinfo
npm-debug.log*

# Local data — uploaded CVs and rendered documents are PII (Constitution §8). They belong in a
# volume, never in the repository, and never in a diff.
uploads/
backups/
*.dump

# Celery Beat's last-run database. It belongs on a volume (see docker-compose.yml); this is the
# backstop for the day someone runs `celery beat` by hand in the source tree.
celerybeat-schedule*
celerybeat.pid

# Docs — kept local by the owner's decision (2026-09-04), NARROWED 2026-09-10.
#
# The original rule ignored all of docs/, and its own comment recorded the consequence: the durable
# documents everything else links to were absent from a fresh clone. That became concrete when slice
# 1.2 went up for review — ADR-0012 ("outbound HTTP is a guarded egress") is the contract the whole
# SSRF adapter was built against, and it was not in the diff, so a reviewer on GitHub was reading
# the guard without the reasoning.
#
# So the two DURABLE, CROSS-SLICE documents are now tracked and everything else stays local:
#
#   tracked  — docs/adr/**          decisions that outlive the slice that made them
#              docs/constitution.md the standing rules every ADR is written against
#
#   local    — docs/PRD.md          product strategy
#              docs/specs/**        disposable; they die when the feature ships
#              docs/roadmap.md, sdlc.md, cicd.md, infrastructure.md, explanations/
#
# The repository is PUBLIC, so this is a publishing decision, not a storage one. The tracked files
# were scanned before the first commit: no IPs, no hostnames beyond `tailorcraft.app` and `ghcr.io`,
# no credentials, and no server specifics (`SSH_HOST` appears only as the NAME of a CI secret).
# Anything added to docs/adr/ later inherits that obligation — an ADR is public the moment it lands.
docs/*
!docs/adr/
!docs/constitution.md

# Editors / OS
.idea/
.vscode/
.DS_Store

# Claude Code local overrides (settings.json IS committed — the hooks are part of the harness)
.claude/settings.local.json
