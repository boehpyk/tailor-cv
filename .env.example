# Copy to .env and fill in. NEVER commit .env — the pre-commit hook refuses it.
# On the production box this file is created BY HAND, once, mode 600, and is never shipped from CI.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# The SAFE value is the default. Dev-ness comes from loading docker-compose.dev.yml, which pins
# APP_ENV=dev in `environment:` (which outranks env_file:). Do not "fix" this to dev — the file you
# copy to get a working laptop must not also be the file that would put the VDS in dev mode.
APP_ENV=production
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_DATABASE=tailorcraft
DB_USERNAME=tailorcraft
DB_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://tailorcraft:change-me@postgres:5432/tailorcraft

# The test database is DEDICATED and is never the dev one. `make test` runs against this.
TEST_DATABASE_URL=postgresql+asyncpg://tailorcraft:change-me@postgres:5432/tailorcraft_test

# ---------------------------------------------------------------------------
# Redis — broker, result backend, cache, and rate-limiter store. Always password-protected.
# ---------------------------------------------------------------------------
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@redis:6379/0
CELERY_BROKER_URL=redis://:change-me@redis:6379/1
CELERY_RESULT_BACKEND=redis://:change-me@redis:6379/2

# ---------------------------------------------------------------------------
# LLM (ADR-0004)
# ---------------------------------------------------------------------------
# NOT set in CI, deliberately: a suite that would silently start spending money if a key appeared is
# a suite that is one secret away from a surprise bill. Tests drive the fake LlmPort.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=25
LLM_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# Auth (ADR-0008)
# ---------------------------------------------------------------------------
# Rotating this logs everyone out. That is intended — it is the break-glass control.
JWT_SIGNING_KEY=change-me-to-32-plus-random-bytes
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# ---------------------------------------------------------------------------
# Storage & retention (ADR-0006)
# ---------------------------------------------------------------------------
UPLOAD_DIR=/var/lib/tailorcraft/uploads
MAX_UPLOAD_BYTES=10485760
# FR-6: guest data lives at most one day. This is a privacy promise, not a tuning knob — raising it
# needs a reason a user would accept, not a convenience.
GUEST_RETENTION_HOURS=24

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
PUBLIC_BASE_URL=https://tailorcraft.app
CORS_ORIGINS=https://tailorcraft.app
# Rate limits on the endpoint that costs money per call. An unauthenticated endpoint that spends
# money is a funded denial-of-wallet (Constitution §8).
TAILORING_RATE_LIMIT_PER_HOUR=10

# ---------------------------------------------------------------------------
# Deployment (set on the box by the deploy job; leave blank locally so `build` is used)
# ---------------------------------------------------------------------------
TAILORCRAFT_API_IMAGE=
TAILORCRAFT_WEB_IMAGE=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
SENTRY_DSN=
