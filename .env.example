# Copy to .env and fill in. NEVER commit .env — the pre-commit hook refuses it.
# On the production box this file is created BY HAND, once, mode 600, and is never shipped from CI.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# The SAFE value is the default. Dev-ness comes from loading docker-compose.dev.yml, which pins
# APP_ENV=dev in `environment:` (which outranks env_file:). Do not "fix" this to dev — the file you
# copy to get a working laptop must not also be the file that would put the VDS in dev mode.
APP_ENV=production
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_DATABASE=tailorcraft
DB_USERNAME=tailorcraft
DB_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://tailorcraft:change-me@postgres:5432/tailorcraft

# The test database is DEDICATED and is never the dev one. `make test` runs against this.
TEST_DATABASE_URL=postgresql+asyncpg://tailorcraft:change-me@postgres:5432/tailorcraft_test

# ---------------------------------------------------------------------------
# Redis — broker, result backend, cache, and rate-limiter store. Always password-protected.
# ---------------------------------------------------------------------------
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@redis:6379/0
CELERY_BROKER_URL=redis://:change-me@redis:6379/1
CELERY_RESULT_BACKEND=redis://:change-me@redis:6379/2
# The test suite's own Redis database — the counterpart of TEST_DATABASE_URL, and left commented out
# on purpose. Empty means "derive it from REDIS_URL with the database number swapped to 3", so the
# password stays written down once; a second copy is one more thing to rotate and one more to
# forget. Uncomment only to point the suite somewhere else entirely, such as its own Redis server.
#
# It must not resolve to the same (host, port, database) as REDIS_URL, CELERY_BROKER_URL or
# CELERY_RESULT_BACKEND — the app refuses to start if it does. The suite calls `flushdb()` between
# tests, so a test Redis that is secretly the live one erases the guest-purge heartbeat, the queue
# bindings and the rate limiters on every run. That was the state of things until 2026-09-22.
# TEST_REDIS_URL=redis://:change-me@redis:6379/3

# ---------------------------------------------------------------------------
# LLM (ADR-0004)
# ---------------------------------------------------------------------------
# NOT set in CI, deliberately: a suite that would silently start spending money if a key appeared is
# a suite that is one secret away from a surprise bill. Tests drive the fake LlmPort.
#
# Empty is LEGAL in dev and test — tailor() then raises llm_unavailable immediately, logs
# llm.not_configured once and makes no API call. Empty is FATAL when APP_ENV=production: the process
# REFUSES TO BOOT (AC-32). The alternative is a green health check in front of a product where every
# run fails after the user has already waited fifteen seconds for it.
GEMINI_API_KEY=
# Flash, not Pro: the budget is 15 seconds and the task is rewriting, not reasoning. Recorded on
# every run as a provenance fact, so a swap shows up in the history rather than in a deploy date.
GEMINI_MODEL=gemini-2.5-flash
# Per ATTEMPT. Enforced with asyncio.wait_for around the SDK call, not with a client option.
LLM_REQUEST_TIMEOUT_SECONDS=12.0
# The hard outer bound over the whole call, retries and backoff included. DELIBERATELY ABOVE the
# 15-second budget: 12 + 1 + 12 = 25, so a run that retries misses the budget. That is accepted and
# visible rather than hidden — a 15 s deadline would cut the second attempt off part-way and
# relabel every retryable blip as a timeout.
LLM_TOTAL_DEADLINE_SECONDS=25
# Total attempts, not retries: 2 means one retry, and only for the four retryable failure classes.
# A refusal is never retried — it is a refusal repeated at twice the price.
LLM_MAX_ATTEMPTS=2
LLM_RETRY_BACKOFF_SECONDS=1.0
# Bounds a runaway generation before the documents' own ceilings have to.
LLM_MAX_OUTPUT_TOKENS=4096
# The pre-flight refusal, checked BEFORE any API call. Reject, never truncate — a run against a CV
# the user did not know was cut is a wrong answer they cannot diagnose.
LLM_MAX_CV_CHARACTERS=25000

# ---------------------------------------------------------------------------
# Auth (ADR-0008)
# ---------------------------------------------------------------------------
# Signs ACCESS tokens (HS256). In production the api refuses to start if this is empty, this
# placeholder, or shorter than 32 bytes — generate one with `openssl rand -base64 48`. The placeholder
# is fine in dev and test.
#
# Rotating it does NOT log anyone out (ADR-0008 amendment (d)): refresh tokens are opaque database
# rows, not JWTs, so rotation invalidates only the outstanding access tokens and the next silent
# refresh mints new ones. It also resets the login rate limiter's per-email counters, harmlessly.
# The break-glass that ends every session is:
#     python -m tailorcraft.cli revoke-logins --all
JWT_SIGNING_KEY=change-me-to-32-plus-random-bytes
# Bounded: 1..60 minutes and 1..90 days, refused at startup outside that range.
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Login and registration limits (AC-27), checked before any password is hashed. They fail CLOSED:
# with Redis down, login and register answer 503 rather than hash unmetered. Refresh, logout and
# /me have no limiter and no Redis dependency, so an outage stops new logins but logs nobody out.
LOGIN_RATE_LIMIT_PER_IP_PER_HOUR=20
LOGIN_RATE_LIMIT_PER_EMAIL_PER_HOUR=10
REGISTER_RATE_LIMIT_PER_IP_PER_HOUR=5

# ---------------------------------------------------------------------------
# Storage & retention (ADR-0006)
# ---------------------------------------------------------------------------
UPLOAD_DIR=/var/lib/tailorcraft/uploads
MAX_UPLOAD_BYTES=10485760
# FR-6: guest data lives at most one day. This is a privacy promise, not a tuning knob — raising it
# needs a reason a user would accept, not a convenience.
GUEST_RETENTION_HOURS=24
# Whether beat runs the hourly guest purge (ADR-0018 decision 5). FALSE until the purge has been
# rehearsed by hand on this box — it deletes rows and unlinks files, and neither comes back. The
# order is in docs/infrastructure.md, *Guest data retention (runbook)*: `make purge.dry`, then
# `make purge limit=50`, then confirm `curl -s localhost:8080/health/ready | jq .jobs.guest_purge`
# shows the backlog falling, then `make purge`. Only then flip this to true.
# While it is false the CLI still purges on demand, and /health/ready says `scheduled: false` in
# words the UI repeats — a promise that is not being kept automatically should be visible, not
# filed.
GUEST_PURGE_ENABLED=false

# CV text extraction (ADR-0009). The timeout is a backstop for a pathological file, not the
# mechanism — the page cap bounds the work before parsing ever starts.
EXTRACTION_TIMEOUT_SECONDS=10
MAX_CV_PAGES=50

# Upload rate limiting & caps (F-16, F-23, F-24). Per-session bounds one guest; per-IP bounds one
# network across many guest sessions (a guest can always mint a new one). Fails OPEN if Redis is
# down — this endpoint costs disk and CPU, not money (OQ-7; contrast TAILORING_RATE_LIMIT_PER_HOUR
# below, whose endpoint fails CLOSED for exactly that reason).
UPLOAD_RATE_LIMIT_PER_HOUR=10
UPLOAD_RATE_LIMIT_PER_IP_PER_HOUR=30
MAX_BASE_CVS_PER_SESSION=5
# Reverse-proxy hops in front of this process that are ours to trust when reading
# X-Forwarded-For (infrastructure/rate_limit.py::client_ip). 1 is nginx. Do not raise this without
# actually adding a trusted proxy in front of nginx — nginx must also never run
# ngx_http_realip_module, or two layers end up reconstructing "the real client" independently.
TRUSTED_PROXY_HOPS=1

# ---------------------------------------------------------------------------
# Job-posting intake — the guarded egress (slice 1.2, ADR-0012)
# ---------------------------------------------------------------------------
# Bounds on ONE outbound request to a host a stranger chose. Note what is NOT here and never will
# be: any setting that disables or weakens the SSRF address policy. A flag that turns off a security
# control is a flag someone eventually sets in production.
#
# POSTING_FETCH_TIMEOUT_SECONDS is the hard outer bound. The per-phase timeouts below are what a
# hostile server evades by trickling one byte before each read deadline; the outer one stops it.
POSTING_FETCH_TIMEOUT_SECONDS=10
POSTING_FETCH_CONNECT_TIMEOUT_SECONDS=3.0
POSTING_FETCH_READ_TIMEOUT_SECONDS=5.0
# Enforced on DECODED bytes while streaming, never from Content-Length — that header is a claim by
# the party we are defending against, and a chunked response carries none at all.
POSTING_FETCH_MAX_BYTES=2097152
# Every hop re-runs the whole guard. The row people forget is a public host that 302s to
# http://169.254.169.254/latest/meta-data/ — that is caught at the hop, not at the first URL.
POSTING_FETCH_MAX_REDIRECTS=3
POSTING_EXTRACTION_TIMEOUT_SECONDS=5

# Two counters with DIFFERENT behaviour when Redis is unreachable, deliberately. Creating a posting
# fails OPEN (the cost is our own database, and it is bounded). Fetching fails CLOSED (the cost is
# someone else's infrastructure, spent from our IP address) — an unbounded outbound endpoint with no
# backstop is how a server ends up on a job board's blocklist.
POSTING_RATE_LIMIT_PER_HOUR=20
POSTING_FETCH_RATE_LIMIT_PER_HOUR=10
POSTING_FETCH_RATE_LIMIT_PER_IP_PER_HOUR=30
MAX_JOB_POSTINGS_PER_SESSION=10

# The body cap for NON-multipart requests. 30,000 characters of UTF-8 is at most ~120 KB, so this
# refuses an absurd paste before it is parsed and leaves every legal one comfortable. Separate from
# MAX_UPLOAD_BYTES because answering "file_too_large" to a JSON request would be wrong in both the
# number and the wording.
JSON_REQUEST_MAX_BYTES=262144

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
PUBLIC_BASE_URL=https://cv.samolit.com
CORS_ORIGINS=https://cv.samolit.com

# ---------------------------------------------------------------------------
# Tailoring — limits, caps and the queue (slice 1.3)
# ---------------------------------------------------------------------------
# The endpoint that costs MONEY per call, open to guests. Its limiter is the only one in this file
# built with fail_open=False: fail open when the cost is ours and bounded, fail closed when the cost
# is money or somebody else's infrastructure. An unauthenticated endpoint that spends money with no
# backstop is a funded denial-of-wallet, and the first evidence would be an invoice.
TAILORING_RATE_LIMIT_PER_HOUR=10
# Per client IP, because a guest can always mint a new session — the per-session limit alone bounds
# nothing.
TAILORING_RATE_LIMIT_PER_IP_PER_HOUR=30
# Saving an edited document, per session; fails OPEN (one bounded UPDATE of ours). Ten a minute
# sustained is above any human typing rate through the 1.5 s debounce and below what a script
# hammering a PII row should get.
TAILORING_REVISE_RATE_LIMIT_PER_HOUR=600
MAX_TAILORING_RUNS_PER_SESSION=20
# How long a run may stay `running` before the stale-run sweep (beat, every minute) records it
# `abandoned`. NOT a tuning knob: it MUST stay above Celery's hard task_time_limit (180), and the API,
# worker and beat all refuse to start otherwise. At or below the limit, the sweep can abandon a call
# that is still running, and its paid-for result is lost. Do not shorten it to recover interrupted
# runs faster.
TAILORING_STALE_AFTER_SECONDS=300
# A named queue from the first slice, so 1.5's exports can land on a second one without a long
# render starving a tailoring run.
TAILORING_QUEUE_NAME=tailoring

# ---------------------------------------------------------------------------
# Export rendering — limits, caps and the queue (slice 1.5, ADR-0016/0017)
# ---------------------------------------------------------------------------
# TXT and Markdown render inline; PDF and DOCX go to the worker on their own named queue, for the
# same reason TAILORING_QUEUE_NAME got one in 1.3 — a long render must not starve a tailoring run
# sharing the worker's slots.
EXPORT_QUEUE_NAME=export
# Per QUEUED render (PDF/DOCX). Must sit under the task's soft limit (120) and hard limit (180).
EXPORT_RENDER_TIMEOUT_SECONDS=60
# Per INLINE render (TXT/Markdown). A 20,000-character document parses in milliseconds, so this is
# the backstop for something pathological, not the mechanism that keeps an inline render fast.
EXPORT_INLINE_TIMEOUT_SECONDS=5
# A renderer bug must not be free to fill the uploads volume `api` and `worker` share.
EXPORT_MAX_FILE_BYTES=20971520
# How long an export job may stay `rendering` before the stale-job sweep (beat, every 60 s) records
# it `failed` / `abandoned`. NOT a tuning knob, same reason as TAILORING_STALE_AFTER_SECONDS: it
# MUST stay above Celery's hard task_time_limit (180), and the API, worker and beat all refuse to
# start otherwise. At or below the limit, the sweep can abandon a render still in progress.
EXPORT_STALE_AFTER_SECONDS=300
# Fails OPEN (export:create): a render costs worker seconds and disk of ours, bounded by the
# per-session cap below and the purge — there is no invoice.
EXPORT_RATE_LIMIT_PER_HOUR=30
# Per client IP, because a guest can always mint a new session.
EXPORT_RATE_LIMIT_PER_IP_PER_HOUR=60
# A cross-aggregate cap: 2 documents x 2 formats x a generous number of re-exports, bounded by the
# purge.
MAX_EXPORT_JOBS_PER_SESSION=40

# ---------------------------------------------------------------------------
# Deployment (set on the box by the deploy job; leave blank locally so `build` is used)
# ---------------------------------------------------------------------------
TAILORCRAFT_API_IMAGE=
TAILORCRAFT_WEB_IMAGE=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
SENTRY_DSN=
